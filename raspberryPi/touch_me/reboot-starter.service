[Unit]
Description=UDP Audio Receiver & Player on Boot
After=network-online.target bluetooth.target sound.target user@1000.service
Wants=network-online.target user@1000.service

[Service]
Type=simple
User=student334
Group=student334
WorkingDirectory=/home/student334/CES334-2025/raspberryPi/touch_me
Environment=HOME=/home/student334
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 -u /home/student334/CES334-2025/raspberryPi/touch_me/receiver.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target


